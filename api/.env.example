# Servidor
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# CORS: origens separadas por vírgula (ex: http://localhost:3000). 
# Em produção, nunca utilize '*' com credentials: true.
CORS_ORIGIN=http://localhost:3000

# Banco de Dados PostgreSQL (bate com o docker-compose.yml na raiz)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventos_db

# Autenticação JWT (Obrigatório, min 32 caracteres)
# Gere uma chave segura com: openssl rand -base64 64
JWT_SECRET=coloque-aqui-uma-chave-secreta-com-minimo-de-32-caracteres

# TMDb API (The Movie Database) - Obrigatório para busca e catalogação de filmes
# Obtenha sua chave gratuita em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_de_api_tmdb_aqui
